<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization"><String Id="TauriLanguage">1033</String><String Id="TauriCodepage">1252</String><String Id="LaunchApp">Launch AudioDeviceManager</String><String Id="DowngradeErrorMessage">A newer version of AudioDeviceManager is already installed.</String><String Id="PathEnvVarFeature">Add the install location of the AudioDeviceManager executable to the PATH system environment variable. This allows the AudioDeviceManager executable to be called from any location.</String><String Id="InstallAppFeature">Installs AudioDeviceManager.</String></WixLocalization>